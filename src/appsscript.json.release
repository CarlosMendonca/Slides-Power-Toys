{
  "timeZone": "America/New_York",
  "dependencies": {
  },
  "webapp": {
    "access": "ANYONE",
    "executeAs": "USER_ACCESSING"
  },
  "exceptionLogging": "STACKDRIVER",
  "oauthScopes": [
    "https://www.googleapis.com/auth/presentations.currentonly"
  ],
  "runtimeVersion": "V8",
  "addOns": {
    "common": {
      "name": "Slides Power Toys",
      "logoUrl": "https://www.gstatic.com/images/branding/product/1x/slides_48dp.png"
    },
    "slides": {
      "homepageTrigger": {
        "runFunction": "onHomepage"
      }
    }
  }
}